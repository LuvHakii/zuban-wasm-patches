Subject: [PATCH 3/3] revert: exclude panic_hooks from wasm build

---
 crates/zubanls/src/lib.rs    | 1 +
 crates/zubanls/src/server.rs | 5 ++++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/crates/zubanls/src/lib.rs b/crates/zubanls/src/lib.rs
index 5a5973f03..f258ca8d6 100644
--- a/crates/zubanls/src/lib.rs
+++ b/crates/zubanls/src/lib.rs
@@ -3,6 +3,7 @@ mod client_config;
 mod custom;
 mod notebooks;
 mod notification_handlers;
+#[cfg(not(target_family = "wasm"))]
 mod panic_hooks;
 mod request_handlers;
 mod semantic_tokens;
diff --git a/crates/zubanls/src/server.rs b/crates/zubanls/src/server.rs
index 8b887d545..bfae993b0 100644
--- a/crates/zubanls/src/server.rs
+++ b/crates/zubanls/src/server.rs
@@ -23,7 +23,9 @@ use crate::client_config::{ClientConfig, TypeCheckingMode};
 use crate::notebooks::Notebooks;
 use crate::notification_handlers::TestPanic;
 use crate::request_handlers::to_uri;
-use crate::{Cli, custom, panic_hooks};
+#[cfg(not(target_family = "wasm"))]
+use crate::panic_hooks;
+use crate::{Cli, custom};
 
 // Since we currently don't do garbage collection, we simply delete the project and reindex,
 // because it's not that expensive after a specific amount of diagnostics.
@@ -140,6 +142,7 @@ pub fn run_server_with_custom_connection(
     });
 
     // On panic, notify the client.
+    #[cfg(not(target_family = "wasm"))]
     let _hook = panic_hooks::enter(Box::new(move |panic_info| {
         use std::io::Write;
 
