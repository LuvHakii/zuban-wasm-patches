diff --git a/crates/zubanls/src/wasm.rs b/crates/zubanls/src/wasm.rs
new file mode 100644
index 000000000..998eb8990
--- /dev/null
+++ b/crates/zubanls/src/wasm.rs
@@ -0,0 +1,138 @@
+use std::rc::Rc;
+
+use config::{Mode, ProjectOptions};
+use lsp_server::{Message, Response};
+use lsp_types::request::{Initialize, Request as _};
+use lsp_types::InitializeParams;
+use vfs::{InMemoryFs, VfsHandler as _};
+use wasm_bindgen::prelude::*;
+use zuban_python::{Project, RunCause};
+
+use crate::capabilities::{ClientCapabilities, server_capabilities};
+use crate::client_config::ClientConfig;
+use crate::server::{GlobalState, from_json, patch_path_prefix, version};
+
+#[wasm_bindgen(start)]
+pub fn start() {
+    console_error_panic_hook::set_once();
+}
+
+#[wasm_bindgen]
+pub struct ZubanLS {
+    state: Option<GlobalState<'static>>,
+    fs: InMemoryFs,
+    mypy_compat: bool,
+    sender: &'static crossbeam_channel::Sender<lsp_server::Message>,
+    output: crossbeam_channel::Receiver<lsp_server::Message>,
+}
+
+#[wasm_bindgen]
+impl ZubanLS {
+    #[wasm_bindgen(constructor)]
+    pub fn new(mypy_compat: Option<bool>) -> ZubanLS {
+        let (sender, receiver) = crossbeam_channel::unbounded();
+        ZubanLS {
+            state: None,
+            fs: InMemoryFs::new(),
+            mypy_compat: mypy_compat.unwrap_or_default(),
+            sender: Box::leak(Box::new(sender)),
+            output: receiver,
+        }
+    }
+
+    pub fn set_file(&self, path: &str, contents: &str) {
+        self.fs.set_file(path, contents);
+    }
+
+    pub fn handle_message(&mut self, msg: &str) -> Vec<String> {
+        let Ok(msg) = serde_json::from_str(msg) else {
+            return Vec::new();
+        };
+        match msg {
+            Message::Request(req) if req.method == Initialize::METHOD => {
+                self.initialize(req);
+            }
+            msg @ (Message::Request(_) | Message::Notification(_)) => {
+                let state = match &mut self.state {
+                    Some(state) => state,
+                    None => return Vec::new(),
+                };
+                state.on_lsp_message_and_return_on_shutdown(msg);
+                state.publish_diagnostics_if_necessary();
+            }
+            Message::Response(_) => {}
+        }
+        self.drain_output()
+    }
+}
+
+impl ZubanLS {
+    fn initialize(&mut self, req: lsp_server::Request) {
+        let params: InitializeParams = from_json(Initialize::METHOD, &req.params).unwrap();
+
+        #[expect(deprecated)]
+        let workspace_roots = params
+            .workspace_folders
+            .as_ref()
+            .and_then(|ws| ws.first())
+            .map(|w| &w.uri)
+            .or(params.root_uri.as_ref())
+            .map(|uri| Rc::new([patch_path_prefix(uri).unwrap()]))
+            .unwrap_or_else(|| Rc::new(["/".to_string()]));
+
+        let client_config: ClientConfig = params
+            .initialization_options
+            .as_ref()
+            .and_then(|options| serde_json::from_value(options.clone()).ok())
+            .unwrap_or_default();
+
+        let mode = if self.mypy_compat {
+            Mode::Mypy
+        } else {
+            Mode::Default
+        };
+        let mut options = ProjectOptions::default_for_mode(mode);
+        options.settings.typeshed_path = Some(self.fs.normalize_unchecked_abs_path("/typeshed"));
+        for root in workspace_roots.iter() {
+            options
+                .settings
+                .mypy_path
+                .push(self.fs.normalize_unchecked_abs_path(root));
+        }
+        let project = Project::new(Box::new(self.fs.clone()), options, RunCause::LanguageServer);
+
+        let caps = ClientCapabilities::new(params.capabilities);
+        let capabilities = server_capabilities(&caps, &client_config);
+
+        self.state = Some(GlobalState::new(
+            client_config,
+            self.sender,
+            caps,
+            workspace_roots,
+            None,
+        ));
+        self.state.as_mut().unwrap().project = Some(project);
+
+        let result = lsp_types::InitializeResult {
+            capabilities,
+            server_info: Some(lsp_types::ServerInfo {
+                name: "zuban".into(),
+                version: Some(version().into()),
+            }),
+            offset_encoding: None,
+        };
+        let _ = self
+            .sender
+            .send(Message::Response(Response::new_ok(
+                req.id,
+                serde_json::to_value(result).unwrap(),
+            )));
+    }
+
+    fn drain_output(&self) -> Vec<String> {
+        self.output
+            .try_iter()
+            .map(|msg| serde_json::to_string(&msg).unwrap())
+            .collect()
+    }
+}
