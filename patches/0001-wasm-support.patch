diff --git a/crates/vfs/src/memory.rs b/crates/vfs/src/memory.rs
new file mode 100644
index 0000000..81a928c
--- /dev/null
+++ b/crates/vfs/src/memory.rs
@@ -0,0 +1,130 @@
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, RwLock},
+};
+
+use crossbeam_channel::Receiver;
+use utils::FastHashMap;
+
+use crate::{
+    Directory, DirectoryEntry, Entries, FileEntry, NotifyEvent, Parent, PathWithScheme, VfsHandler,
+    Workspace,
+};
+
+#[derive(Clone, Default)]
+pub struct InMemoryFs {
+    // Keys have no leading/trailing '/'. Sorted, so a directory is a key range.
+    files: Arc<RwLock<BTreeMap<String, String>>>,
+}
+
+impl InMemoryFs {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    // ponytail: no `.`/`..` handling, the host passes clean paths.
+    pub fn set_file(&self, path: &str, contents: impl Into<String>) {
+        self.files
+            .write()
+            .unwrap()
+            .insert(key(path).to_string(), contents.into());
+    }
+}
+
+fn key(path: &str) -> &str {
+    path.trim_matches('/')
+}
+
+impl VfsHandler for InMemoryFs {
+    fn read_and_watch_file(&self, path: &PathWithScheme) -> Option<String> {
+        self.files.read().unwrap().get(key(&path.path)).cloned()
+    }
+
+    fn notify_receiver(&self) -> Option<&Receiver<NotifyEvent>> {
+        None
+    }
+
+    fn on_invalidated_in_memory_file(&self, _path: PathWithScheme) {}
+
+    fn read_and_watch_dir(&self, _: &[Arc<Workspace>], path: &str, parent: Parent) -> Entries {
+        let base = key(path);
+        let prefix = if base.is_empty() {
+            String::new()
+        } else {
+            format!("{base}/")
+        };
+        let mut entries = FastHashMap::default();
+        for (k, _) in self.files.read().unwrap().range(prefix.clone()..) {
+            let Some(rest) = k.strip_prefix(&prefix) else {
+                break;
+            };
+            let (name, is_dir) = match rest.split_once('/') {
+                Some((name, _)) => (name, true),
+                None => (rest, false),
+            };
+            let name: Arc<str> = name.into();
+            let entry = if is_dir {
+                DirectoryEntry::Directory(Directory::new(parent.clone(), name.clone()))
+            } else {
+                DirectoryEntry::File(FileEntry::new(parent.clone(), name.clone()))
+            };
+            entries.insert(name, entry);
+        }
+        Entries::new(entries)
+    }
+
+    fn read_and_watch_entry(
+        &self,
+        _: &[Arc<Workspace>],
+        path: &str,
+        parent: Parent,
+        replace_name: &str,
+    ) -> Option<DirectoryEntry> {
+        let k = key(path);
+        let files = self.files.read().unwrap();
+        if files.contains_key(k) {
+            return Some(DirectoryEntry::File(FileEntry::new(
+                parent,
+                replace_name.into(),
+            )));
+        }
+        let prefix = format!("{k}/");
+        let (first, _) = files.range(prefix.clone()..).next()?;
+        first
+            .starts_with(&prefix)
+            .then(|| DirectoryEntry::Directory(Directory::new(parent, replace_name.into())))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Weak;
+
+    #[test]
+    fn dirs_and_files() {
+        let fs = InMemoryFs::new();
+        fs.set_file("/a/b.py", "1");
+        fs.set_file("/a/c/d.py", "2");
+        fs.set_file("/ab.py", "3");
+        let parent = || Parent::Workspace(Weak::new());
+        let entries = fs.read_and_watch_dir(&[], "/a", parent());
+        let map = entries.borrow();
+        assert_eq!(map.len(), 2);
+        assert!(matches!(map["b.py"], DirectoryEntry::File(_)));
+        assert!(matches!(map["c"], DirectoryEntry::Directory(_)));
+        assert!(
+            fs.read_and_watch_entry(&[], "/a/c", parent(), "c")
+                .is_some_and(|e| matches!(e, DirectoryEntry::Directory(_)))
+        );
+        assert!(
+            fs.read_and_watch_entry(&[], "/a/x", parent(), "x")
+                .is_none()
+        );
+        assert!(
+            fs.read_and_watch_entry(&[], "/a/b", parent(), "b")
+                .is_none()
+        );
+        assert_eq!(fs.read_and_watch_dir(&[], "/", parent()).borrow().len(), 2);
+    }
+}
